# ── MySQL（共享 infra：native_rag 库，独立账号 native_rag_user）──
MYSQL_USER=native_rag_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=native_rag
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ── Milvus（统一语义检索 + BGE-M3 稀疏混合检索）──
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ── HuggingFace 模型下载镜像（国内加速）──
HF_ENDPOINT=https://hf-mirror.com

# ── MinerU 文档解析 ──
# 留空则使用本地 MinerU；填入 mineru.net 申请的 Token 则走官方 API（快但文档上传云端）
MINERU_API_TOKEN=

# ── 检索无结果兜底阈值（rerank 最高分低于此值才判"文档无关"，返回空、不发 sources）──
SIMILARITY_THRESHOLD_LOW=0.20

# ── 低置信阈值（rerank 最高分在 [SIMILARITY_THRESHOLD_LOW, 此值) 之间视为"相关性存疑"，
#    检索结果照常返回，但 LLM 被提示相关性存疑、不足以回答则如实说"未找到"）──
RERANK_LOW_CONFIDENCE_THRESHOLD=0.50

# ── DeepSeek LLM（切换模型只改 DEEPSEEK_MODEL）──
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
# 首轮 LLM 瞬时错误（429/5xx）退避重试（仅首轮且未流出事件时整体重试）
# CHAT_LLM_MAX_ATTEMPTS=2    # 总调用次数上限（含首次）：2 = 首次失败后重试 1 次
# CHAT_LLM_RETRY_BACKOFF_SECONDS=0.5

# ── Embedding 模型（FastEmbed 支持的中文模型，768 维比 bge-small-zh 语义更强）──
EMBEDDING_MODEL_NAME=jinaai/jina-embeddings-v2-base-zh
EMBEDDING_DEVICE=cpu

# ── Rerank 模型（本地）──
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu

# ── Admin 预设账号 ──
ADMIN_USERNAME=admin
# 必须替换为强随机值！空/占位值会导致服务启动失败（安全 fail-fast）
ADMIN_PASSWORD=change_me_admin

# ── JWT ──
# 必须替换为强随机值（如 openssl rand -hex 32）！空/占位值会导致服务启动失败（安全 fail-fast）
JWT_SECRET_KEY=generate_a_random_string_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── 文件上传 ──
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# ── Redis 聊天问答缓存（相同问题+空上下文命中重放，省 DeepSeek 计费）──
REDIS_URL=redis://redis:6379/2   # 共享 Redis db index 2（隔离规范）
REDIS_PORT=6379
# CHAT_CACHE_ENABLED=true
# CHAT_CACHE_TTL_SECONDS=7200

# ── 登录防爆破（Redis 计数）──
# 同一账号连续失败达 LOGIN_FAIL_MAX 次临时锁定，窗口过期自动重置；Redis 故障时 fail-open
# LOGIN_FAIL_MAX=5
# LOGIN_FAIL_WINDOW_SECONDS=900

# ── CORS 白名单（前端经 nginx 同源反代本不需 CORS，兜底直连开发）──
# CORS_ORIGINS=["http://localhost:8089","http://localhost:5173"]

# ── 会话过期清理（最后活跃 updated_at 超保留期物理删除，硬删除不可逆）──
# 定时 sweep + 查询时惰性清理双机制；异常时设 CHAT_CLEANUP_ENABLED=false 一键停
CHAT_RETENTION_DAYS=30
CHAT_CLEANUP_ENABLED=true
# CHAT_CLEANUP_INTERVAL_SECONDS=3600
# CHAT_CLEANUP_BATCH_SIZE=500
